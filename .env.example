# ============================================================
# HandyIn 配置文件
# 使用方式：cp .env.example .env 后按需修改
# 然后运行 docker compose up -d --build
# ============================================================

# ---- 访问路径与端口 ----

# 子路径前缀（前后端、API、WebSocket 全部共用）。改这里整站换路径。
HANDYIN_BASE_PATH=/handyin

# Caddy 对外 HTTP 端口（容器内固定 80，这里映射到宿主机端口）
# 例如想通过 http://服务器IP:8080/handyin/ 访问，改成 8080
CADDY_HTTP_PORT=80

# Caddy 对外 HTTPS 端口（启用域名自动 HTTPS 时使用）
CADDY_HTTPS_PORT=443

# Caddy 站点地址
#   仅 IP + HTTP 访问：        SITE_ADDRESS=http://:80
#   自定义端口 HTTP 访问：      SITE_ADDRESS=http://:80   （端口由 CADDY_HTTP_PORT 控制）
#   有域名（自动 HTTPS）：      SITE_ADDRESS=handyin.example.com
SITE_ADDRESS=http://:80

# ---- 数据库 ----

POSTGRES_DB=handyin
POSTGRES_USER=handyin
# 必填：数据库密码（请改成强密码）
POSTGRES_PASSWORD=change-me-strong-password

# ---- 安全 ----

# 必填：Session Cookie 签名密钥（请改成随机长字符串）
SESSION_SECRET=change-me-to-a-random-secret

# Cookie Secure：HTTP/IP 访问设为 false；启用 HTTPS 后改为 true
COOKIE_SECURE=false

# 登录限流：每分钟允许的登录失败次数
LOGIN_RATE_LIMIT=5

# ---- 初始教师账号（首次启动自动创建）----

INIT_TEACHER_USERNAME=admin
# 必填：初始密码（首次登录后请立即修改）
INIT_TEACHER_PASSWORD=change-me-now

# ---- 其他 ----

TZ=Asia/Shanghai
LOG_LEVEL=info
MAX_UPLOAD_SIZE=10mb
MAX_UPLOAD_FILES=1
