{
  "name": "handyin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @handyin/server prisma:generate",
    "db:push": "pnpm --filter @handyin/server prisma:push",
    "db:migrate": "pnpm --filter @handyin/server prisma:migrate"
  }
}
